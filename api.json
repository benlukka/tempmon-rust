{
  "openapi": "3.0.0",
  "info": {
    "title": "Tempmon Server",
    "version": "2.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api"
    }
  ],
  "tags": [],
  "paths": {
    "/db-version": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/measurements": {
      "post": {
        "requestBody": {
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MeasurementInput"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      },
      "get": {
        "parameters": [
          {
            "name": "limit",
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "in": "query",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Measurement"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "parameters": [
          {
            "name": "start_date",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "in": "query",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "end_date",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "in": "query",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Measurement"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/devices": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Device"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Device": {
        "type": "object",
        "title": "Device",
        "required": [
          "id",
          "unique_identifier",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "unique_identifier": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Measurement": {
        "type": "object",
        "title": "Measurement",
        "required": [
          "id",
          "device",
          "capabilities",
          "value",
          "recorded_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "device": {
            "type": "string"
          },
          "capabilities": {
            "$ref": "#/components/schemas/MeasurementType"
          },
          "value": {},
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MeasurementInput": {
        "type": "object",
        "title": "MeasurementInput",
        "required": [
          "device",
          "capability",
          "value"
        ],
        "properties": {
          "device": {
            "type": "string"
          },
          "capability": {
            "$ref": "#/components/schemas/MeasurementType"
          },
          "value": {}
        }
      },
      "MeasurementType": {
        "type": "string",
        "enum": [
          "Temperature",
          "Humidity",
          "Voltage",
          "Pressure"
        ]
      }
    }
  }
}